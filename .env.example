# AgentECHO Environment Configuration

# ============================================
# Version Control
# ============================================
# Docker image version tag (default: latest)
AGENTECHO_VERSION=latest

# ============================================
# Security - REQUIRED
# ============================================
# API Token for authentication between services
# Generate with: openssl rand -base64 32
INGEST_TOKEN=

# ============================================
# ClickHouse Database
# ============================================
# ClickHouse Configuration (optional - defaults work for local dev)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
# Leave empty for no password (local dev only)
# For production, generate with: openssl rand -base64 24
CLICKHOUSE_PASSWORD=

# ============================================
# Server Configuration
# ============================================
BUFFER_SIZE=1000
FLUSH_INTERVAL=1
DEFAULT_PRICE_PER_1K=5.0
DEFAULT_PAY_THROUGH=0.5

# ============================================
# Dashboard Configuration
# ============================================
# Dashboard API Configuration (set these for production)
API_URL=http://server:8080/v1

# ============================================
# Production - Traefik Reverse Proxy
# ============================================
# Enable Traefik dashboard (true/false)
TRAEFIK_DASHBOARD=false

# Email for Let's Encrypt certificates
ACME_EMAIL=admin@example.com

# Your production domains
# PRODUCTION_DOMAIN=agentecho.example.com
# API_DOMAIN=api.agentecho.example.com

